[Unit]
Description=LLRC Flask Application
After=network.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/www/llrc
Environment="PATH=/var/www/llrc/venv/bin"
Environment="FLASK_ENV=production"
Environment="FLASK_DEBUG=False"
ExecStart=/var/www/llrc/venv/bin/gunicorn -c gunicorn.conf.py app.run:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5

# 安全设置
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/llrc /var/log/llrc

[Install]
WantedBy=multi-user.target
